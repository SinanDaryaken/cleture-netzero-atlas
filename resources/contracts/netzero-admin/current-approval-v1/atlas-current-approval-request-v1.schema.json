{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:netzeroadmin:schema:atlas-current-approval-request:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "delivery_sha256",
    "expected_resolution",
    "base_catalog"
  ],
  "properties": {
    "schema_version": {
      "const": "netzero-atlas-current-approval-request/v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "delivery_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "expected_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "identity_sha256",
        "source",
        "proposal_key",
        "revision_id",
        "revision",
        "proposal_sha256",
        "receipt_sha256",
        "resolution_id",
        "resolution_version",
        "resolution_sha256",
        "previous_resolution_id",
        "decision_id",
        "decision_sha256",
        "supersedes_decision_id",
        "ruleset_sha256",
        "proposal_type",
        "status",
        "published_target"
      ],
      "properties": {
        "family_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "identity_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "dataset",
            "release",
            "raw"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "dataset": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "release": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "raw": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "asset_key",
                "sha256",
                "size_bytes"
              ],
              "properties": {
                "asset_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 67108864
                }
              }
            }
          }
        },
        "proposal_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "proposal_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        "resolution_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "resolution_version": {
          "type": "integer",
          "minimum": 1
        },
        "resolution_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        "previous_resolution_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
            }
          ]
        },
        "decision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "decision_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        "supersedes_decision_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
            }
          ]
        },
        "ruleset_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        "proposal_type": {
          "enum": [
            "alias",
            "new_unit",
            "new_quantity_kind",
            "exact_conversion",
            "context_relation",
            "monetary_measure"
          ]
        },
        "status": {
          "const": "approved_at_lookup"
        },
        "published_target": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "catalog_version",
                "catalog_sha256",
                "definition_id",
                "definition_sha256",
                "quantity_kind_id",
                "unit_code"
              ],
              "properties": {
                "catalog_version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "catalog_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                },
                "definition_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
                },
                "definition_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                },
                "quantity_kind_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
                },
                "unit_code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                }
              }
            }
          ]
        }
      }
    },
    "base_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        }
      }
    }
  }
}
