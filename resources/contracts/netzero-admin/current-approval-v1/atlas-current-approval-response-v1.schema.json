{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:netzeroadmin:schema:atlas-current-approval-response:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "key_id",
    "request_id",
    "request_sha256",
    "request_nonce",
    "delivery_sha256",
    "status",
    "reason",
    "state_sha256",
    "checked_at",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": "netzero-atlas-current-approval-response/v1"
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "request_nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$(?![\\s\\S])"
    },
    "delivery_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "status": {
      "enum": [
        "current",
        "not_current",
        "unavailable"
      ]
    },
    "reason": {
      "enum": [
        "exact_current_approval",
        "approval_or_expected_state_changed",
        "trusted_evidence_unavailable"
      ]
    },
    "state_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        }
      ]
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validity",
        "recheck_before_use",
        "cache_allowed",
        "automatic_mapping_allowed",
        "usage_allowed",
        "publish_allowed"
      ],
      "properties": {
        "validity": {
          "const": "checked_at_only"
        },
        "recheck_before_use": {
          "const": true
        },
        "cache_allowed": {
          "const": false
        },
        "automatic_mapping_allowed": {
          "const": false
        },
        "usage_allowed": {
          "const": false
        },
        "publish_allowed": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "current"
          }
        }
      },
      "then": {
        "properties": {
          "state_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
          },
          "reason": {
            "const": "exact_current_approval"
          }
        }
      },
      "else": {
        "properties": {
          "state_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_current"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "approval_or_expected_state_changed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "trusted_evidence_unavailable"
          }
        }
      }
    }
  ]
}
