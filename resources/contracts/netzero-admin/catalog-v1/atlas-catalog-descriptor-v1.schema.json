{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:netzeroadmin:schema:atlas-catalog-descriptor:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner",
    "catalog",
    "version",
    "content_schema_version",
    "canonicalization",
    "sha256",
    "size_bytes",
    "artifact_path"
  ],
  "properties": {
    "schema_version": {
      "const": "atlas-catalog-snapshot/v1"
    },
    "owner": {
      "const": "NetZeroAdmin"
    },
    "catalog": {
      "enum": [
        "unit",
        "geography"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "content_schema_version": {
      "enum": [
        "unit-catalog-release/v1",
        "netzero-geography-snapshot/v1"
      ]
    },
    "canonicalization": {
      "const": "netzero-sorted-json-v1"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "artifact_path": {
      "type": "string",
      "pattern": "^atlas-catalog-snapshots/(unit|geography)/sha256/[a-f0-9]{64}\\.json$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "catalog": {
            "const": "unit"
          }
        },
        "required": [
          "catalog"
        ]
      },
      "then": {
        "properties": {
          "content_schema_version": {
            "const": "unit-catalog-release/v1"
          },
          "artifact_path": {
            "pattern": "^atlas-catalog-snapshots/unit/sha256/"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "catalog": {
            "const": "geography"
          }
        },
        "required": [
          "catalog"
        ]
      },
      "then": {
        "properties": {
          "content_schema_version": {
            "const": "netzero-geography-snapshot/v1"
          },
          "artifact_path": {
            "pattern": "^atlas-catalog-snapshots/geography/sha256/"
          },
          "version": {
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
