{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:netzeroadmin:schema:atlas-catalog-unit:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "definitions",
    "conversions"
  ],
  "properties": {
    "schema_version": {
      "const": "unit-catalog-release/v1"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "unit_type_id",
          "unit_dimension_id",
          "unit_code",
          "unit_symbol",
          "dimension_code",
          "transform_kind",
          "is_base",
          "scale",
          "offset",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "unit_type_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "unit_dimension_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "unit_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "unit_symbol": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          },
          "dimension_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "transform_kind": {
            "enum": [
              "ratio",
              "affine"
            ]
          },
          "is_base": {
            "type": "boolean"
          },
          "scale": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "numerator",
              "denominator"
            ],
            "properties": {
              "numerator": {
                "type": "string",
                "pattern": "^(?:0|-?[1-9][0-9]*)$"
              },
              "denominator": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            }
          },
          "offset": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "numerator",
              "denominator"
            ],
            "properties": {
              "numerator": {
                "type": "string",
                "pattern": "^(?:0|-?[1-9][0-9]*)$"
              },
              "denominator": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "conversions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_definition_id",
          "to_definition_id",
          "from_code",
          "to_code",
          "multiplier",
          "offset",
          "sha256"
        ],
        "properties": {
          "from_definition_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "to_definition_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "from_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "to_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "multiplier": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "numerator",
              "denominator"
            ],
            "properties": {
              "numerator": {
                "type": "string",
                "pattern": "^(?:0|-?[1-9][0-9]*)$"
              },
              "denominator": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            }
          },
          "offset": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "numerator",
              "denominator"
            ],
            "properties": {
              "numerator": {
                "type": "string",
                "pattern": "^(?:0|-?[1-9][0-9]*)$"
              },
              "denominator": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
