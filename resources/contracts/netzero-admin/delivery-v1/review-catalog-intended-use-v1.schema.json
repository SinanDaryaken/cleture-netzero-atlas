{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:netzeroadmin:schema:review-catalog-intended-use:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner",
    "policy",
    "uses"
  ],
  "properties": {
    "schema_version": {
      "const": "netzero-intended-use-snapshot/v1"
    },
    "owner": {
      "const": "NetZeroAdmin"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels_are_aliases",
        "applicability_inferred",
        "human_review_required"
      ],
      "properties": {
        "labels_are_aliases": {
          "const": false
        },
        "applicability_inferred": {
          "const": false
        },
        "human_review_required": {
          "const": true
        }
      }
    },
    "uses": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_id",
          "names",
          "description",
          "active",
          "compatibility",
          "sha256"
        ],
        "properties": {
          "canonical_id": {
            "enum": [
              "corporate_carbon_footprint",
              "product_carbon_footprint",
              "life_cycle_assessment"
            ]
          },
          "names": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tr",
              "en"
            ],
            "properties": {
              "tr": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              }
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "active": {
            "type": "boolean"
          },
          "compatibility": {
            "const": "human_review_required"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
