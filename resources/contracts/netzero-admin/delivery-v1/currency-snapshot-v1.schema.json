{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:netzeroadmin:schema:currency-snapshot:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner",
    "policy",
    "currencies"
  ],
  "properties": {
    "schema_version": {
      "const": "netzero-currency-snapshot/v1"
    },
    "owner": {
      "const": "NetZeroAdmin"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fx_conversion",
        "symbols_are_aliases",
        "scientific_dimension"
      ],
      "properties": {
        "fx_conversion": {
          "const": false
        },
        "symbols_are_aliases": {
          "const": false
        },
        "scientific_dimension": {
          "const": false
        }
      }
    },
    "currencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "code",
          "name",
          "symbol",
          "active",
          "deleted",
          "usable",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{3}$(?![\\s\\S])"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "active": {
            "type": "boolean"
          },
          "deleted": {
            "type": "boolean"
          },
          "usable": {
            "type": "boolean"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
          }
        }
      }
    }
  }
}
