{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:netzeroadmin:schema:review-catalog-taxonomy:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner",
    "policy",
    "nodes",
    "category_consumption_links"
  ],
  "properties": {
    "schema_version": {
      "const": "netzero-taxonomy-snapshot/v1"
    },
    "owner": {
      "const": "NetZeroAdmin"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels_are_aliases",
        "applicability_inferred",
        "human_review_required"
      ],
      "properties": {
        "labels_are_aliases": {
          "const": false
        },
        "applicability_inferred": {
          "const": false
        },
        "human_review_required": {
          "const": true
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_id",
          "id",
          "kind",
          "active",
          "deleted",
          "sort_order",
          "main",
          "parents",
          "names",
          "sha256"
        ],
        "properties": {
          "canonical_id": {
            "type": "string",
            "pattern": "^(protocol|scope|segment|category|consumption_type|material):[a-f0-9]{8}-[a-f0-9]{4}-7[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-7[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
          },
          "kind": {
            "enum": [
              "protocol",
              "scope",
              "segment",
              "category",
              "consumption_type",
              "material"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "deleted": {
            "type": "boolean"
          },
          "sort_order": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "main": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "parents": {
            "type": "array",
            "minItems": 0,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^(protocol|scope|segment|category|consumption_type|material):[a-f0-9]{8}-[a-f0-9]{4}-7[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
            }
          },
          "names": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "language_id",
                "language_code",
                "language_usable",
                "name",
                "description"
              ],
              "properties": {
                "language_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-7[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
                },
                "language_code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 35
                },
                "language_usable": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 10000
                }
              }
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "category_consumption_links": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category_id",
          "consumption_type_id",
          "deleted",
          "sort_order",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-7[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
          },
          "category_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-7[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
          },
          "consumption_type_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-7[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
          },
          "deleted": {
            "type": "boolean"
          },
          "sort_order": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
