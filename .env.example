APP_NAME="NetZero Atlas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=laravel-dev-postgres
DB_PORT=5432
DB_DATABASE=atlas_netzero
DB_USERNAME=dev_admin
DB_PASSWORD=
ATLAS_DB_USERNAME=dev_admin
ATLAS_DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=atlas_raw
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=laravel-dev-redis
REDIS_PASSWORD=
REDIS_PORT=6379
ATLAS_REDIS_PASSWORD=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ATLAS_MINIO_ROOT_USER=atlas-local
ATLAS_MINIO_ROOT_PASSWORD=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
ATLAS_RAW_BUCKET=atlas-raw
ATLAS_PROCESSING_BUCKET=atlas-processing
ATLAS_CANDIDATES_BUCKET=atlas-candidates
ATLAS_RAW_DISK=atlas_raw

ATLAS_HTTP_CONNECT_TIMEOUT_SECONDS=10
ATLAS_HTTP_TIMEOUT_SECONDS=30
ATLAS_ADEME_DATASET_URL=https://data.ademe.fr/data-fair/api/v1/datasets/base-carboner

VITE_APP_NAME="${APP_NAME}"
